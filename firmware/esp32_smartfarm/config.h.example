/**
 * Smart Precision Farming — ESP32 Node Configuration Template
 * 
 * STEP-BY-STEP SETUP INSTRUCTIONS:
 * 1. Copy this template to "config.h" in the same directory:
 *      cp firmware/esp32_smartfarm/config.h.example firmware/esp32_smartfarm/config.h
 * 2. Log in to the web dashboard as Admin (https://smartfarm.hostless.app).
 * 3. Navigate to "Devices" page.
 * 4. For device "ESP32-PN-001", click "Rotate / Generate Token" and copy the token (gfd_...).
 * 5. Paste the token into DEVICE_TOKEN below.
 * 6. Update WIFI_SSID and WIFI_PASSWORD with your local Wi-Fi credentials.
 * 7. Flash the firmware to your ESP32 board.
 * 
 * NOTE: "config.h" is included in .gitignore and will NEVER be committed to Git.
 */

#ifndef SMARTFARM_CONFIG_H
#define SMARTFARM_CONFIG_H

// ==========================================
// 1. Wi-Fi Configuration
// ==========================================
#define WIFI_SSID       "YOUR_WIFI_SSID"
#define WIFI_PASSWORD   "YOUR_WIFI_PASSWORD"
#define WIFI_TIMEOUT_MS 15000 // 15 seconds connection timeout

// ==========================================
// 2. Backend API Endpoint & Transport Security
// ==========================================
// Set USE_HTTPS to true for production cloud endpoints with TLS verification.
// Set USE_HTTPS to false for local network HTTP testing on your LAN.
#define USE_HTTPS true 

// Production host for Smart Precision Farming
#define API_HOST "smartfarm.hostless.app"
#define API_PORT 443

// Ingestion endpoint path matching backend contract
#define API_INGEST_PATH "/api/v1/telemetry/ingest"

// Device Credentials (obtain via Admin web panel -> Devices -> Rotate Token)
#define DEVICE_ID    "ESP32-PN-001"
#define DEVICE_TOKEN "gfd_paste_your_revocable_device_token_here"

// ==========================================
// 3. Hardware Pin Mapping
// ==========================================
// I2C Pins (Shared by SHT40 and SH1106 OLED)
#define PIN_I2C_SDA 21
#define PIN_I2C_SCL 22
#define OLED_I2C_ADDRESS 0x3C

// RS485 / Modbus (MAX485 transceiver to 7-in-1 soil sensor)
#define PIN_RS485_RX 16
#define PIN_RS485_TX 17
#define PIN_RS485_DE_RE 4 // HIGH = Transmit, LOW = Receive
#define MODBUS_SLAVE_ID 1
#define MODBUS_BAUDRATE 4800 // 4800 baud matching soil sensor default

// Hall-Effect Tipping Bucket Rain Gauge
#define PIN_RAIN_GAUGE 13
#define RAIN_MM_PER_PULSE 0.1498f // Standard tipping bucket resolution: 0.1498 mm/tip
#define RAIN_DEBOUNCE_MS 100      // 100ms interrupt debounce filtering mechanical contact chatter

// ==========================================
// 4. Scheduling & Timers
// ==========================================
#define TELEMETRY_UPLOAD_INTERVAL_MS 60000 // Ingest every 60 seconds
#define SENSOR_READ_INTERVAL_MS      5000  // Read sensors every 5 seconds
#define OLED_PAGE_CYCLE_MS           3000  // Cycle OLED page every 3 seconds

// ==========================================
// 5. NTP Time Server
// ==========================================
#define NTP_SERVER_1 "pool.ntp.org"
#define NTP_SERVER_2 "time.nist.gov"
#define TIMEZONE_OFFSET_SEC 19800 // IST (UTC +5:30) = 19800 seconds
#define DAYLIGHT_OFFSET_SEC 0

