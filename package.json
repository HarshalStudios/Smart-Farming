{
  "name": "smart-precision-farming",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server.ts --production",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "tsc -b",
    "test": "tsx server/tests/postgresCompatibilityTest.ts && tsx server/tests/phase2Test.ts && tsx server/tests/phase3FirmwareTest.ts && tsx server/tests/phase4LiveIntegrationTest.ts",
    "test:postgres": "tsx server/tests/postgresCompatibilityTest.ts",
    "test:firmware": "tsx server/tests/phase3FirmwareTest.ts",
    "test:phase4": "tsx server/tests/phase4LiveIntegrationTest.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "tsx": "^4.23.15"
  }
}
